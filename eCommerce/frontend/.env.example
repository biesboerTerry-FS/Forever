# Copy to .env. Must match the backend PORT locally.
# Base backend URL only (no trailing slash, do NOT append /api).
VITE_BACKEND_URL=http://localhost:4001
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Public site URL used to generate sitemap.xml and robots.txt at build time.
# On Vercel this can be left unset — the deployment URL is used automatically.
# Set it when you have a custom domain.
VITE_SITE_URL=

# Optional: real Google sign-in. Create an OAuth 2.0 Web client at
# https://console.cloud.google.com/apis/credentials and add your dev origin
# (e.g. http://localhost:5178) to the authorised JavaScript origins. The
# backend must use the same value in GOOGLE_CLIENT_ID. Leave empty to show the
# labelled demo social-login button in development only.
VITE_GOOGLE_CLIENT_ID=
