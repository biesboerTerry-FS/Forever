# Copy to .env and fill in your own values. Never commit .env.
# Port the API listens on (frontend/admin VITE_BACKEND_URL must point here)
PORT=4001

# MongoDB connection string. The app uses the "e-commerce" database regardless
# of whether the URI includes a database name.
# Local dev:  mongodb://127.0.0.1:27017
# Atlas:      mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Comma-separated list of extra browser origins allowed to call the API.
# Localhost and *.vercel.app are always allowed; add custom domains here.
# CORS_ORIGINS=https://forever.example.com,https://admin.forever.example.com

# Public storefront URL used in emails (defaults to the request origin)
# FRONTEND_URL=https://forever.example.com

# Cloudinary (image hosting for product uploads)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET_KEY=your_api_secret

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Payments (test keys are fine for development)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
RAZORPAY_KEY_SECRET=...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_WEBHOOK_SECRET=...

# Transactional email (optional). Without RESEND_API_KEY, reset links and order
# receipts are printed to the server console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=Forever <onboarding@resend.dev>

# OAuth (optional). Leave GOOGLE_CLIENT_ID empty to hide social sign-in. The
# demo social login is only available in development, regardless of this flag.
GOOGLE_CLIENT_ID=
ALLOW_DEMO_OAUTH=true

# Clerk authentication (used by the storefront and mobile frontends).
# Get this from your Clerk Dashboard → API Keys for this application.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
