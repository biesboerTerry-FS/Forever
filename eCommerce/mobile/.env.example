# Base URL of the Forever API. Use your computer's LAN IP when running on a
# physical device, e.g. http://192.168.1.20:4001
EXPO_PUBLIC_API_URL=http://localhost:4001

# Clerk authentication (mobile frontend).
# Get this from your Clerk Dashboard → API Keys for this application.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Used by the backend to verify Clerk session tokens (keep secret).
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
