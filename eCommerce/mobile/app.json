{
	"expo": {
		"name": "Forever",
		"slug": "forever-mobile",
		"version": "1.0.0",
		"scheme": "forever",
		"orientation": "portrait",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"icon": "./assets/icon.png",
		"splash": {
			"image": "./assets/splash.png",
			"resizeMode": "contain",
			"backgroundColor": "#0b0b0b"
		},
		"ios": {
			"supportsTablet": true,
			"icon": "./assets/icon.png"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#0b0b0b"
			},
			"package": "com.forever.mobile",
			"icon": "./assets/icon.png"
		},
		"web": {
			"bundler": "metro",
			"output": "single",
			"favicon": "./assets/favicon.png"
		},
		"extra": {
			"eas": {
				"projectId": ""
			}
		}
	}
}
